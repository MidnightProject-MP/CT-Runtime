# Non-secret Cloud Run Job configuration. Replace every REPLACE value.
CT_RUNTIME_MODE=production
CT_RUNTIME_PROVIDER=cloud-run
CT_RUNTIME_CLASS=cloud-run-job
CT_RUNTIME_REGION=REPLACE_REGION
CT_RUNTIME_DEPLOYMENT_ID=REPLACE_IMMUTABLE_DEPLOYMENT_ID
CT_RUNTIME_S3_ENDPOINT=REPLACE_S3_ENDPOINT
CT_RUNTIME_S3_BUCKET=REPLACE_S3_BUCKET
CT_RUNTIME_S3_REGION=us-east-1
CT_RUNTIME_S3_PATH_STYLE=false
CT_RUNTIME_NAMESPACE=ct-runtime
CT_RUNTIME_IMAGE_DIGEST=sha256:REPLACE_IMAGE_DIGEST
CT_RUNTIME_CONFIG_DIGEST=sha256:REPLACE_CONFIG_DIGEST
CT_RUNTIME_GIT_REPOSITORY=REPLACE_REPOSITORY
CT_RUNTIME_GIT_COMMIT=REPLACE_COMMIT
MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free

# Only OpenRouter credentials named here can enter the OpenCode child process.
# Database and S3 credentials are always rejected from this allowlist.
CT_RUNTIME_PROVIDER_SECRET_NAMES=OPENROUTER_API_KEY
